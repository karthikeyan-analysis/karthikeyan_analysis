rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasUserAdminRole() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function hasAdminProfile() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role == "admin";
    }

    function isAdmin() {
      return hasUserAdminRole() || hasAdminProfile();
    }

    // Public read keeps website images, testimonial files, and shared download
    // URLs working. Writes stay limited to signed-in admins from either app.
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /examTests/{testId}/questions/{questionId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /studentPhotos/{studentId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /content/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /videos/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

