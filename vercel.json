{
  "buildCommand": "npm --prefix \"student portal\" install && npm --prefix \"student portal\" run build",
  "outputDirectory": "student portal/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/realtime/:path*",
      "destination": "https://us-central1-karthikeyan-analysis.cloudfunctions.net/realtimeProxy/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
