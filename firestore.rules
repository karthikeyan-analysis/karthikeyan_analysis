rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function adminPath(uid) {
      return /databases/$(database)/documents/admins/$(uid);
    }

    function hasUserRole(role) {
      return isSignedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.role == role;
    }

    function hasAdminProfile() {
      return isSignedIn()
        && exists(adminPath(request.auth.uid))
        && get(adminPath(request.auth.uid)).data.role == "admin";
    }

    function isAdmin() {
      return hasUserRole("admin") || hasAdminProfile();
    }

    function isStudent() {
      return hasUserRole("student");
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // Website admin panel and student portal admin profile records.
    match /admins/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // Public website storefront.
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /achievements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /siteSettings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /productReviews/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /contacts/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /orders/{id} {
      // Public order lookup is used by order placed / track order pages.
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Student portal shared data.
    match /batches/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /students/{id} {
      // The app queries students by email during Google/guest login and admins load full lists.
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /content/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /videos/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Legacy schedule tests used by the student portal.
    match /tests/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // In-app CBT engine.
    match /examTests/{testId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();

      match /questionsPublic/{qId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }

      // Client-side scoring reads private keys; keep write access admin-only.
      match /questionsPrivate/{qId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }

      match /guestProfiles/{uid} {
        allow read: if isAdmin() || isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.testId == testId;
        allow update: if isAdmin() || isOwner(uid);
        allow delete: if isAdmin();
      }

      match /attempts/{uid} {
        allow read: if isAdmin() || isOwner(uid);
        allow create, update: if isOwner(uid) || isAdmin();
        allow delete: if isAdmin();
      }
    }

    // Admin safety net for future app-managed collections.
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
