rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function adminPath(uid) {
      return /databases/$(database)/documents/admins/$(uid);
    }

    function hasUserAdminRole() {
      return isSignedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.role == "admin";
    }

    function hasAdminProfile() {
      return isSignedIn()
        && exists(adminPath(request.auth.uid))
        && get(adminPath(request.auth.uid)).data.role == "admin";
    }

    function isAdmin() {
      return hasUserAdminRole() || hasAdminProfile();
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function selfStudentProfile() {
      return isSignedIn()
        && request.resource.data.role == "student";
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isAdmin() || (isOwner(uid) && selfStudentProfile());
      allow update: if isAdmin()
        || (
          isOwner(uid)
          && resource.data.role == "student"
          && request.resource.data.role == "student"
        );
      allow delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Website public storefront.
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /achievements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /siteSettings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /productReviews/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /contacts/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /orders/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Student portal data.
    match /batches/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /students/{id} {
      // Needed for student Google login and guest matching by email.
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /content/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /videos/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /tests/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /examTests/{testId} {
      // Public read is needed before guest sign-in for passcode exam join.
      allow read: if true;
      allow write: if isAdmin();

      match /questionsPublic/{qId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }

      match /questionsPrivate/{qId} {
        // Current client scoring reads keys; admins can always manage them.
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }

      match /guestProfiles/{uid} {
        allow read: if isAdmin() || isOwner(uid);
        allow create, update: if isAdmin() || isOwner(uid);
        allow delete: if isAdmin();
      }

      match /attempts/{uid} {
        allow read: if isAdmin() || isOwner(uid);
        allow create, update: if isAdmin() || isOwner(uid);
        allow delete: if isAdmin();
      }
    }

    match /liveClasses/{id} {
      // Signed-in read so students can see schedules/status before joining.
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();

      match /attendance/{studentRecordId} {
        // Keyed by studentRecordId, not uid — ownership is checked via the studentUid field.
        allow read: if isAdmin() || resource.data.studentUid == request.auth.uid;
        allow create: if isSignedIn() && request.resource.data.studentUid == request.auth.uid;
        allow update: if isAdmin() || resource.data.studentUid == request.auth.uid;
        allow delete: if isAdmin();
      }

      match /doubts/{doubtId} {
        // Visible only to admins (host/co-host) and the student who raised it.
        allow read: if isAdmin() || resource.data.studentUid == request.auth.uid;
        allow create: if isSignedIn() && request.resource.data.studentUid == request.auth.uid;
        allow update, delete: if isAdmin();
      }

      match /presence/{uid} {
        // Live roster — readable by anyone signed in so participants can see who's in the call.
        // A participant owns their own doc; a host/co-host may only flip the three
        // cooperative control flags on someone else's doc, nothing else.
        allow read: if isSignedIn();
        allow create, delete: if isOwner(uid);
        allow update: if isOwner(uid)
          || (
            isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(["mutedByHost", "videoDisabledByHost", "kicked", "updatedAt"])
          );
      }
    }

    match /liveTestSessions/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();

      match /presence/{uid} {
        allow read: if isSignedIn();
        allow create, delete: if isOwner(uid);
        allow update: if isOwner(uid) || isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
